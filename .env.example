# Copy this file to .env. Never commit the resulting .env file.

# Required — browser-safe Supabase project settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Required by server-side and command-line tasks. These may equal the VITE values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key

# Recommended — AI classification, visual understanding, and Ask Kept.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

# Recommended — semantic search and retrieval.
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_MODEL=voyage-4

# Optional — used only by Apple import and local migration commands.
KEPT_EMAIL=you@example.com
KEPT_PASSWORD=your_kept_account_password

# Optional — required for Telegram capture and administrative backfills.
# This key is server-only. Never create a VITE_SUPABASE_SERVICE_ROLE_KEY variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_legacy_service_role_key
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_secret

# Optional local API port (defaults to 8787).
PORT=8787
HOST=127.0.0.1
